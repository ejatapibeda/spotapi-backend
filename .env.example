# Copy to .env and fill in. NEVER commit .env or paste its values into shared chats.

# Bearer token the Android app sends as "Authorization: Bearer <APP_TOKEN>".
# Generate: openssl rand -hex 32
APP_TOKEN=

# Fernet key used to encrypt the stored Spotify cookies in /data/spotapi.db.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
#   or:     python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing/changing it = stored session unreadable -> just log in again from the app.
ENC_KEY=

# Port the API listens on (inside and outside the container).
PORT=8080

# Host interface to publish on. 0.0.0.0 = all interfaces. Use 127.0.0.1 when Tailscale Serve /
# Funnel / a reverse proxy runs on the same host (recommended), or your Tailscale IP
# (tailscale ip -4) to make the API reachable only over the tailnet.
BIND_ADDR=0.0.0.0

# Optional: enable POST /api/v1/auth/pair. If set, exchanging this code returns APP_TOKEN.
# Leave empty to disable pairing (endpoint answers 404). Clear it again after pairing,
# especially if the API is reachable from the internet.
PAIRING_CODE=

# uid/gid the container runs as; must own ./data (check with: id -u ; id -g)
PUID=1000
PGID=1000

# Optional tuning
# LOG_LEVEL=info
# DB_PATH=/data/spotapi.db
# SESSION_MAX_AGE_S=2700          # rebuild Spotify session objects after 45 min
# RATE_LIMIT_RETRY_AFTER_S=10     # Retry-After sent on RATE_LIMITED
# NOW_PLAYING_CACHE_MS=1500       # tiny cache so app polling doesn't hammer Spotify
# HTTP_TIMEOUT_S=12               # per-request timeout to Spotify (tls_client)
# HTTP_RETRIES=1                  # extra attempts per request
# TOTP_FETCH_TIMEOUT=6
# TOTP_FETCH_RETRIES=2
# TOTP_SECRET_URLS=https://code.thetadev.de/ThetaDev/spotify-secrets/raw/branch/main/secrets/secretDict.json,https://raw.githubusercontent.com/xyloflake/spot-secrets-go/main/secrets/secretDict.json
